# ==============================================================================
# ECOTRACK - ENVIRONNEMENT CONFIGURATION EXEMPLE
# ==============================================================================

# Environnement d'exécution
NODE_ENV=development
PORT=3000

# 1. Base Opérationnelle MongoDB 7.0 (GeoJSON 2dsphere)
MONGO_INITDB_ROOT_USERNAME=ecotrack_admin
MONGO_INITDB_ROOT_PASSWORD=EcoTrackMongo2026!
MONGO_INITDB_DATABASE=ecotrack_db
MONGODB_URI=mongodb://ecotrack_admin:EcoTrackMongo2026!@localhost:27017/ecotrack_db?authSource=admin

# 2. Entrepôt Décisionnel PostgreSQL 16 (Star Schema DW)
POSTGRES_USER=ecotrack_admin
POSTGRES_PASSWORD=EcoTrackPostgres2026!
POSTGRES_DB=ecotrack_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecotrack_admin:EcoTrackPostgres2026!@localhost:5432/ecotrack_dw

# 3. Cache & Rate Limiting Redis 7.0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=EcoTrackRedis2026!
REDIS_URI=redis://:EcoTrackRedis2026!@localhost:6379/0

# 4. Message Broker RabbitMQ 3.12 (AMQP)
RABBITMQ_DEFAULT_USER=ecotrack_admin
RABBITMQ_DEFAULT_PASS=EcoTrackRabbit2026!
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URI=amqp://ecotrack_admin:EcoTrackRabbit2026!@localhost:5672

# 5. Stockage d'Objets S3 / MinIO (Photos Purgées EXIF)
MINIO_ROOT_USER=ecotrack_minio
MINIO_ROOT_PASSWORD=EcoTrackMinio2026!
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_REPORTS=ecotrack-reports
MINIO_BUCKET_AFTER_PHOTOS=ecotrack-interventions
MINIO_USE_SSL=false

# 6. Sécurité & Authentification JWT (Asymétrique RS256 / Ed25519)
JWT_ACCESS_SECRET="ecotrack-insecure-dev-access-key-32b-min"
JWT_REFRESH_SECRET="ecotrack-insecure-dev-refresh-key-32b-min"
JWT_ACCESS_EXPIRES_IN=900       # 15 minutes
JWT_REFRESH_EXPIRES_IN=604800   # 7 jours
ARGON2_MEMORY_COST=65536        # 64 MB
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# 7. IA Vision & Inférence (FastAPI / YOLOv8 / ViT)
AI_SERVICE_URL=http://localhost:8000
AI_CONFIDENCE_THRESHOLD=0.65
AI_MODEL_VERSION="v2.1.0"
AI_VISION_WEIGHTS=services/ai-vision/weights/mobilenet_v3_small_eco.pth

# 8. API Gateway Nginx
GATEWAY_PORT=8080
CORS_ORIGIN=http://localhost:5173,http://localhost:19006,http://localhost:8081
