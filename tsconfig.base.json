{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@ecotrack/db": ["packages/db/src/index.ts"],
      "@ecotrack/contracts": ["packages/contracts/src/index.ts"],
      "@ecotrack/shared": ["packages/shared/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
