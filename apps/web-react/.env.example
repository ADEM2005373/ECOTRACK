# EcoTrack V2 - Supervision Web (apps/web-react)
# Copy to apps/web-react/.env.local (never committed). VITE_* values are bundled
# into the browser code: never put a secret or a token here.

# Base URL of the report API as seen by the browser. A relative path goes
# through the Vite dev proxy below (no CORS needed in development).
VITE_API_BASE_URL=/api/v1

# Map tiles (SCRUM-59). The public OpenStreetMap server is for development only
# (https://operations.osmfoundation.org/policies/tiles/): use a dedicated tile
# provider in production and update the attribution if the provider changes.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Dev server only (not exposed to the browser): where /api is proxied to.
# 8080 = nginx gateway (docker compose); 3002 = report-api started directly.
API_PROXY_TARGET=http://localhost:8080

# Dev server only (optional, ECO-42): send /api/v1/bi straight to bi-api (port 3006)
# until the gateway routes it. Login (/api/v1/auth) still goes to API_PROXY_TARGET.
# BI_API_PROXY_TARGET=http://localhost:3006
