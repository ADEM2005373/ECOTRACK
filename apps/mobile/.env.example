# EcoTrack Mobile - copier vers apps/mobile/.env (ignoré par Git).
# Les variables EXPO_PUBLIC_* sont intégrées au bundle : aucun secret ici.
#
# URL de base de l'API Gateway :
#   - Simulateur iOS / web      : http://localhost:8080
#   - Émulateur Android         : http://10.0.2.2:8080  (10.0.2.2 = localhost de la machine hôte)
#   - Téléphone physique (Expo Go) : http://<IP-LAN-de-ton-PC>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
