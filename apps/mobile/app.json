{
  "expo": {
    "name": "EcoTrack Mobile",
    "slug": "ecotrack-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ecotrack",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecotrack.mobile"
    },
    "android": {
      "package": "com.ecotrack.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
