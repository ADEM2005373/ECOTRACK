{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mobile/src",
  "tags": ["scope:mobile"],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "npx expo start", "cwd": "apps/mobile" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "npx tsc --noEmit", "cwd": "apps/mobile" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npx jest", "cwd": "apps/mobile" }
    }
  }
}
