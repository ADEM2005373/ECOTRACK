{
  "name": "@ecotrack/bi-api",
  "version": "1.0.0",
  "private": true,
  "description": "EcoTrack V2 - Power BI Embed Token API with Row-Level Security (ECO-42 / SCRUM-53)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
