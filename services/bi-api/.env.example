# EcoTrack V2 - bi-api (ECO-42 / SCRUM-53): Power BI Embed Token API
# Copy to services/bi-api/.env (never committed) and replace every placeholder.
# The service refuses to start if a required variable is missing or malformed.

# Optional, default 3006
PORT=3006

# --- Azure AD Service Principal (required) ---------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=<client-secret-from-azure-portal>

# --- Power BI workspace (required): the service principal must be Member or Admin
POWERBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# --- identity-api public key (required) -------------------------------------
# Must be the SAME RS256 public key identity-api signs with (GET /api/v1/auth/public-key).
# PEM on one line with \n between lines is accepted.
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<base64>\n-----END PUBLIC KEY-----

# --- RLS role mapping (required, JSON) --------------------------------------
# EcoTrack role -> Power BI RLS role names (docs/powerbi_dax_measures.md, ECO-41).
# Allowed keys: ADMIN, AGENT. CITOYEN and OUVRIER are always refused.
# Example adding AGENT: {"ADMIN":["Direction_Generale_DGS"],"AGENT":["Mairie_Arrondissement"]}
POWERBI_RLS_ROLE_MAP={"ADMIN":["Direction_Generale_DGS"]}

# --- Report IDs (optional): a missing one makes that tab answer 503 REPORT_NOT_CONFIGURED
POWERBI_REPORT_ID_OPERATIONNEL=
POWERBI_REPORT_ID_MLOPS=
POWERBI_REPORT_ID_PERFORMANCE_EQUIPES=
POWERBI_REPORT_ID_SLA=
