# ==============================================================================
# bi-etl worker (ECO-24 / SCRUM-57) - environment variables
# Placeholders only: never commit real values. The worker reads the process
# environment directly (no .env loader); set these in your shell or container.
# ==============================================================================

# MongoDB (operational database). Credentials belong in the URI; never log it.
MONGODB_URI=mongodb://<user>:<password>@localhost:27017/?authSource=admin
# Database holding the "reports" collection (default: ecotrack_db)
MONGODB_DB=ecotrack_db

# PostgreSQL data warehouse (libpq DSN or URI). Prefer leaving the password out
# of the DSN and setting the standard libpq variable PGPASSWORD instead.
POSTGRES_DSN=host=localhost port=5432 dbname=ecotrack_dw user=<user>
# PGPASSWORD=<password>

# REQUIRED secret salt for the citizen id pseudonymisation (SHA-256).
# At least 16 characters, random, kept secret, and STABLE: changing it changes
# every citizen_hash. The worker refuses to start if it is missing or empty.
# Generate one with: py -3.12 -c "import secrets; print(secrets.token_hex(32))"
ETL_SALT=<random-secret-of-at-least-16-chars>

# Number of MongoDB documents per batch / PostgreSQL transaction (default 500)
ETL_BATCH_SIZE=500
# Pause between two runs in --loop mode, in seconds (default 300)
ETL_INTERVAL_SECONDS=300
